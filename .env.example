# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Your LinkedIn login email
LINKEDIN_EMAIL=you@example.com

# Optional: paste your li_at cookie from Chrome DevTools
# (Application > Cookies > linkedin.com) to skip the login prompt
# when .linkedin-session/ has no session yet. A working saved session
# is never overwritten. If LinkedIn rejects the cookie, you will still
# be asked to sign in in the Chrome window.
LI_AT=

# Do not put your LinkedIn password in this file.
# The local dashboard passes it only for a single job via the environment.
# Jobs launch your installed Google Chrome, not Puppeteer's bundled browser.
